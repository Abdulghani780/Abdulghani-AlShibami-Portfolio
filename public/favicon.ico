<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0B0C"/>
      <stop offset="50%" stop-color="#141416"/>
      <stop offset="100%" stop-color="#1E1E22"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F3E5AB"/>
      <stop offset="50%" stop-color="#D4AF37"/>
      <stop offset="100%" stop-color="#997A15"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="10" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>
  <!-- Background Shield -->
  <rect width="400" height="400" rx="200" fill="url(#bgGrad)"/>
  <circle cx="200" cy="200" r="192" fill="none" stroke="url(#goldGrad)" stroke-width="3" opacity="0.6"/>
  <circle cx="200" cy="200" r="184" fill="none" stroke="url(#goldGrad)" stroke-width="1" stroke-dasharray="8 6" opacity="0.4"/>
  
  <!-- Silhouette Representation -->
  <circle cx="200" cy="150" r="55" fill="none" stroke="url(#goldGrad)" stroke-width="4" filter="url(#glow)"/>
  <path d="M 100 310 C 100 240, 140 220, 200 220 C 260 220, 300 240, 300 310" fill="none" stroke="url(#goldGrad)" stroke-width="4" stroke-linecap="round" filter="url(#glow)"/>

  <!-- Monogram Brand -->
  <text x="200" y="360" text-anchor="middle" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" letter-spacing="4" fill="#D4AF37">
    ABDULGHANI AL-SHIBAMI
  </text>
  <text x="200" y="380" text-anchor="middle" font-family="'Segoe UI', Roboto, sans-serif" font-size="11" letter-spacing="2" fill="#A1A1AA">
    SYSTEMS &amp; AI ARCHITECT
  </text>
</svg>
