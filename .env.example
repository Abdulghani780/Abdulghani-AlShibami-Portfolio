# ==============================================================================
# ABDULGHANI AL-SHIBAMI PORTFOLIO PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local overrides.
# ==============================================================================

# Public Canonical URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default Locale
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Supabase Public API (Optional — Resilient Local Data Fallback operates if omitted)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-Side Secrets (Never expose to client or prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# CONTACT_NOTIFICATION_EMAIL="contact@abdulghani.dev"
